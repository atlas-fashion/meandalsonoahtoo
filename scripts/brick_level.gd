extends RefCounted

## Builds the module level's stone out of the brick kit (2026-10-10).
##
## The kit (`models/brick/brick_kit.glb`, from `tools/build_brick_kit.py`) was
## generated by Tripo from the user's reference photos: a brick wall, a wall
## with an iron cage, a pillar, a pillar with a torch, a pointed arch, an arched
## door, a barrel vault and a flagstone slab. The LAYOUT is still
## `module_maze.gd`'s cells; only what stands in them changed. Instead of one
## Tripo tunnel section per cell, every cell is assembled:
##
##   - a 3.8 m corridor between brick wall panels (WALL_FACE 1.9 m from the
##     cell centre, 3.5 m high);
##   - a barrel vault springing from the walls at 3.0 m to an inner crown at
##     5.1 m, cut into an L at a corner, a T at a tee and a groin vault at a
##     crossing, so the ceiling turns with the corridor and never shows a seam;
##   - a pointed arch, 1.2 m deep, centred on every opening between two cells,
##     which hides both cells' vault ends and wall ends;
##   - a pillar in each corner of a junction, filling the outside corner where
##     two arches meet;
##   - four flagstone slabs on the floor, laid on a dark bed so the joints
##     between them read as mortar.
##
## Why "seamless": nothing here tiles a piece against a copy of itself without
## something covering the join -- walls end inside arch legs or pillars, vaults
## end inside arches, and the vault variants meet only on their groin lines.
##
## Collision is boxes, on BOTH the player's exact layer and the enemies' simple
## layer: the pieces are flat panels and posts now, so the boxes ARE the shape
## (the old trimeshes existed because Tripo's tunnels were ragged throughout).

const ModuleMaze := preload("res://scripts/module_maze.gd")
const KIT := "res://models/brick/brick_kit.glb"

## Pieces that do NOT cast shadows: the floor and its bed only ever have light
## from above.
const NO_SHADOW := ["floor", "bed"]
## The lid and skirts DO cast, for the moon (2026-10-14): the Tripo vault has a
## few real holes in it, which the lid covers, and the moon would shine through
## them. No torch can see them (they are outside the corridor), so they are on
## their own visual layer, which `module_level._hang_torch` leaves out of every
## torch's `shadow_caster_mask` -- they cost no torch shadow pass.
const MOON_ONLY := ["cap", "skirt"]
const MOON_ONLY_LAYER := 1 << 12
## The floor slabs are ALSO on this layer, which is all the damp patches' decals
## touch (scripts/damp.gd): wet stone on the floor, never on a wall, a cart or a boot.
const WET_LAYER := 1 << 13

const WALL_FACE := 1.9
const WALL_HEIGHT := 3.5
const WALL_DEPTH := 1.0
const SPRING := 3.0
const CROWN := 5.1
## The pointed arch, measured off the built piece: legs 1.69 to 3.16 m out from
## its centre line, springing ~3.3 m, soffit crown ~4.6 m, 5.6 m to its top.
const ARCH_INNER := 1.69
const ARCH_OUTER := 3.16
const ARCH_DEPTH := 1.2
const ARCH_LEG_HEIGHT := 3.3
const ARCH_TOP := 5.6
## Junction pillars: centred this far out on both axes.
const PILLAR_AT := 2.0
const PILLAR_HALF := 0.45
const PILLAR_HEIGHT := 3.2
## The torch pillar's torch head, in the pillar's own frame (front = +Z), as the
## build reported it.
const TORCH_HEAD := Vector3(0.108, 2.746, 0.538)
## A torch pillar stands against a wall as a pilaster: this far proud of it.
const PILASTER_PROUD := 0.3
## Where the lunette panel over a dead end's end wall starts.
const LUNETTE_BASE := 3.1
const FLOOR_TILE := 3.0
## The lid: above the vault's outer crown (6.38 m), under the boss hall's
## floor top (7.0).
const CAP_Y := 6.5
## The lid's skirts on the closed sides run from here up to it: from the floor,
## since a crack where a wall's ragged end meets an arch leg also showed the void.
const SKIRT_LOW := 0.0
## The gate exits' door piece stands this far proud of the end wall.
const DOOR_PROUD := 0.25
## One plain wall in this many is the iron-cage variant instead.
const CAGE_WALL_EVERY := 9

const JUNCTIONS := ["corner", "tee", "cross", "dead", "gate"]

const LAYER_WORLD := 1 | 2
## Both copies of the walls in one: the player's exact layer (9) and the
## enemies' / navmesh's simple layer (10), plus sight (2).
const LAYER_WALLS := 2 | 256 | 512

const STONE_CAST := Color(0.78, 0.88, 1.12)
const VALUE_JITTER := 0.12
const WARMTH_JITTER := 0.05

static var _meshes: Dictionary = {}


## The kit's meshes by piece name, materials fixed once.
static func meshes(tint: float) -> Dictionary:
	if not _meshes.is_empty():
		return _meshes
	if not ResourceLoader.exists(KIT):
		push_error("brick_level: %s is missing -- run tools/build_brick_kit.py" % KIT)
		return {}
	var scene: Node = (load(KIT) as PackedScene).instantiate()
	var fixed := {}
	for node in scene.find_children("*", "MeshInstance3D", true, false):
		var mi := node as MeshInstance3D
		var mesh := mi.mesh
		for s in mesh.get_surface_count():
			var mat := mesh.surface_get_material(s) as StandardMaterial3D
			if mat == null or fixed.has(mat):
				continue
			fixed[mat] = true
			_fix_material(mat, tint)
		_meshes[String(mi.name)] = mesh
	scene.free()
	return _meshes


## Tripo pieces import metallic with a glossy packed map (CLAUDE.md section 4).
static func _fix_material(m: StandardMaterial3D, tint: float) -> void:
	if not m.has_meta("authored_albedo"):
		m.set_meta("authored_albedo", m.albedo_color)
	var base: Color = m.get_meta("authored_albedo")
	# Every light here is a fire, so neutral stone renders orange; leaning the
	# albedo cool brings the reference photos' charcoal grey back once lit.
	m.albedo_color = Color(base.r * tint * STONE_CAST.r, base.g * tint * STONE_CAST.g,
		base.b * tint * STONE_CAST.b, base.a)
	m.metallic = 0.0
	m.metallic_texture = null
	m.roughness_texture = null
	m.roughness = 0.95
	m.specular_mode = BaseMaterial3D.SPECULAR_DISABLED
	if m.normal_enabled:
		m.normal_scale = 1.15
	# Per-instance shade rides in on the MultiMesh colour.
	m.vertex_color_use_as_albedo = true


static var _standalone: Dictionary = {}


## A kit mesh for a plain MeshInstance3D: its materials copied with the
## instance-colour albedo switched off (without an instance colour it renders
## black). Cached per piece.
static func standalone(piece: String) -> Mesh:
	if _standalone.has(piece):
		return _standalone[piece]
	var source: Mesh = meshes(1.0).get(piece)
	if source == null:
		return null
	var copy := source.duplicate() as Mesh
	for s in copy.get_surface_count():
		var m := copy.surface_get_material(s) as StandardMaterial3D
		if m != null:
			m = m.duplicate() as StandardMaterial3D
			m.vertex_color_use_as_albedo = false
			copy.surface_set_material(s, m)
	_standalone[piece] = copy
	return copy


## --- Broken wood (2026-10-10) ----------------------------------------------------
##
## Tripo pieces: a snapped timber support standing against a corridor wall, a
## pile of broken planks and a smashed crate on the floor. Corridor straights
## only, never on a wall that already carries something (a torch, a bone cage, a
## hiding cart) or in a cell with a door, the spawn, a hiding cart or a room.
## Placed after the hiding carts and before the navmesh bake; the support and
## the crate are solid, the planks are walked over.
const SUPPORT_EVERY := 7
const PLANKS_EVERY := 6
const CRATE_EVERY := 9
## The support's back against the wall face; the floor props this far out.
const PROP_OUT := 1.35


static func place_clutter(parent: Node3D, out, blocked: Dictionary, view_range: float) -> Array:
	var placed := {}
	var spots: Array = []
	var add := func(piece: String, xf: Transform3D) -> void:
		var chunk := Vector2i(int(floor((xf.origin.x - out.origin.x) / out.cell_size + 0.5)) / 4,
			int(floor((xf.origin.z - out.origin.z) / out.cell_size + 0.5)) / 4)
		if not placed.has(piece):
			placed[piece] = {}
		if not placed[piece].has(chunk):
			placed[piece][chunk] = []
		placed[piece][chunk].append(xf)
	var body := StaticBody3D.new()
	body.name = "ClutterCollision"
	body.collision_layer = LAYER_WALLS
	body.collision_mask = 0
	parent.add_child(body)
	var rng := RandomNumberGenerator.new()
	var cages: Dictionary = out.get_meta("cage_walls", {})
	for key in out.cells:
		var cell = out.cells[key]
		if cell.kind != "straight" or cell.room >= 0 or cell.court or blocked.has(key):
			continue
		rng.seed = hash(key) ^ 0x70d
		var walls: Array[int] = []
		for side in ModuleMaze.ORDER:
			if cell.open & side:
				continue
			if out.torch_cells.has(key) and int(out.torch_cells[key]) == side:
				continue
			if cages.has(key) and side in cages[key]:
				continue
			walls.append(side)
		if walls.is_empty():
			continue
		var side: int = walls[rng.randi_range(0, walls.size() - 1)]
		var d := _dir(side)
		var into := -d
		var centre: Vector3 = out.to_world(key)
		var along := Vector3(-d.z, 0.0, d.x)
		var roll := rng.randi_range(0, SUPPORT_EVERY * PLANKS_EVERY * CRATE_EVERY - 1)
		if roll % SUPPORT_EVERY == 0:
			var at := centre + d * WALL_FACE
			add.call("wood_support", Transform3D(_yaw_facing(into), at))
			# Its two posts, at the wall.
			for s: float in [-1.0, 1.0]:
				_box(body, Vector3(0.3, 2.4, 0.3), at + into * 0.25 + along * s * 1.15 + Vector3(0.0, 1.2, 0.0))
			spots.append({"cell": key, "at": at + into * 0.35, "half": Vector2(1.4, 0.45)})
		elif roll % PLANKS_EVERY == 1:
			var at := centre + d * PROP_OUT + along * rng.randf_range(-1.2, 1.2)
			add.call("wood_planks", Transform3D(Basis(Vector3.UP, rng.randf() * TAU), at))
		elif roll % CRATE_EVERY == 2:
			var at := centre + d * (WALL_FACE - 0.6) + along * rng.randf_range(-1.6, 1.6)
			add.call("wood_crate", Transform3D(Basis(Vector3.UP, rng.randf_range(-0.4, 0.4)) * _yaw_facing(into), at))
			_box(body, Vector3(0.9, 0.95, 0.85), at + Vector3(0.0, 0.48, 0.0))
			spots.append({"cell": key, "at": at, "half": Vector2(0.5, 0.5)})
	var holder := Node3D.new()
	holder.name = "Clutter"
	parent.add_child(holder)
	_emit(holder, out, meshes(1.0), placed, view_range)
	return spots


static func _yaw_facing(into: Vector3) -> Basis:
	## A basis whose local +Z points along `into`.
	return Basis(Vector3.UP, atan2(into.x, into.z))


static func _dir(side: int) -> Vector3:
	var s: Vector2i = ModuleMaze.DIRS[side]
	return Vector3(float(s.x), 0.0, float(s.y))


## Builds everything. `out` is module_level's Built. Returns the holder node.
static func build(parent: Node3D, out, view_range: float, tint: float) -> Node3D:
	var kit := meshes(tint)
	var holder := Node3D.new()
	holder.name = "BrickLevel"
	parent.add_child(holder)
	if kit.is_empty():
		return holder

	# piece -> chunk -> Array[Transform3D]
	var placed := {}
	var add := func(piece: String, xf: Transform3D) -> void:
		var chunk := Vector2i(int(floor((xf.origin.x - out.origin.x) / out.cell_size + 0.5)) / 4,
			int(floor((xf.origin.z - out.origin.z) / out.cell_size + 0.5)) / 4)
		if not placed.has(piece):
			placed[piece] = {}
		if not placed[piece].has(chunk):
			placed[piece][chunk] = []
		placed[piece][chunk].append(xf)

	# One static body per 4 x 4 cell chunk, not one for the whole map: a single
	# map-sized body overlaps every moving body's broadphase box all the time,
	# and physics measured 8-13 ms a frame against 4-7 with the old modules.
	var bodies := {}

	var half: float = out.cell_size * 0.5
	var rng := RandomNumberGenerator.new()
	for key in out.cells:
		var cell = out.cells[key]
		var centre: Vector3 = out.to_world(cell.pos)
		rng.seed = hash(cell.pos) ^ 0x51a7
		var chunk_key := Vector2i(cell.pos.x / 4, cell.pos.y / 4)
		if not bodies.has(chunk_key):
			var sb := StaticBody3D.new()
			sb.name = "BrickWalls_%d_%d" % [chunk_key.x, chunk_key.y]
			sb.collision_layer = LAYER_WALLS
			sb.collision_mask = 0
			holder.add_child(sb)
			bodies[chunk_key] = sb
		var body: StaticBody3D = bodies[chunk_key]

		# Floor: four slabs, each turned a random quarter, on every cell --
		# courts included, but not the boss block (its stair has its own).
		var boss_block: bool = cell.court and _in_boss_block(out, cell)
		if not boss_block:
			for fx: float in [-1.0, 1.0]:
				for fz: float in [-1.0, 1.0]:
					var b := Basis(Vector3.UP, float(rng.randi_range(0, 3)) * PI * 0.5)
					add.call("floor", Transform3D(b, centre + Vector3(fx, 0.0, fz) * FLOOR_TILE * 0.5))
			# Its top just under the slabs' joints, never over the slabs.
			add.call("bed", Transform3D(Basis(), centre + Vector3(0.0, -0.16, 0.0)))
		if cell.court:
			continue

		var basis: Basis = Basis(Vector3.UP, -float(cell.turn) * PI * 0.5)
		# Vault.
		var vault := "vault_straight"
		match cell.kind:
			"corner": vault = "vault_corner"
			"tee": vault = "vault_tee"
			"cross": vault = "vault_cross"
		if cell.kind == "straight" and out.skylights.has(cell.pos):
			vault = "vault_sky"
		add.call(vault, Transform3D(basis, centre))
		# A dark lid over the vault's back: anything that slips between two
		# pieces shows rock, never sky, and from a court it is the arcade's roof.
		if not out.skylights.has(cell.pos):
			add.call("cap", Transform3D(Basis(), centre + Vector3(0.0, CAP_Y, 0.0)))
		else:
			# Over a skylight, a frame of lid round the shaft (2026-10-14): with
			# no lid at all, the vault's own small holes let the moon through
			# beside the shaft. Four strips of the same 6.02 m slab, scaled,
			# leaving a hole just outside the shaft's liner.
			var hx := 0.7
			var hz := 1.4
			var full := 3.01
			for s: float in [-1.0, 1.0]:
				var side_w := full - hx
				add.call("cap", Transform3D(basis * Basis.from_scale(Vector3(side_w / 6.02, 1.0, 1.0)),
					centre + basis * Vector3(s * (hx + side_w * 0.5), CAP_Y, 0.0)))
				var end_l := full - hz
				add.call("cap", Transform3D(basis * Basis.from_scale(Vector3(hx * 2.0 / 6.02, 1.0, end_l / 6.02)),
					centre + basis * Vector3(0.0, CAP_Y, s * (hz + end_l * 0.5))))

		# Sides.
		for side in ModuleMaze.ORDER:
			var d := _dir(side)
			var into := -d
			var face_basis := _yaw_facing(into)
			if cell.open & side:
				var other: Vector2i = cell.pos + ModuleMaze.DIRS[side]
				if not out.cells.has(other):
					continue
				var other_court: bool = out.cells[other].court
				# Once per boundary: from the lower-ordered cell, or always from
				# the cell when the other side is a court (which builds nothing).
				var canonical: bool = not (other.x < cell.pos.x
					or (other.x == cell.pos.x and other.y < cell.pos.y))
				if not (canonical or other_court):
					continue
				var mid := centre + d * half
				add.call("arch", Transform3D(face_basis, mid))
				_arch_collision(body, mid, d)
				continue

			# A closed side: a wall, its face WALL_FACE in from the centre.
			var piece := "wall"
			# A bone cage (module_level.place_windows) is the Tripo cage wall:
			# the skull and its loot sit inside the iron cage, whose gate is cut
			# free so it swings. Only there -- no empty cages elsewhere.
			if out.niches.has(cell.pos) and (out.niches[cell.pos]["dir"] as Vector3).dot(d) > 0.5:
				piece = "wall_cage"
				# Torches and hiding carts keep off it: the cage stands 0.5 m out.
				var cages: Dictionary = out.get_meta("cage_walls", {})
				if not cages.has(cell.pos):
					cages[cell.pos] = []
				cages[cell.pos].append(side)
				out.set_meta("cage_walls", cages)
			var at := centre + d * WALL_FACE
			add.call(piece, Transform3D(face_basis, at))
			# The dark lid's side: closes the space over the vault on this
			# side, so the Tripo vault's own broken bricks (it has a few real
			# holes) show rock, not the void.
			add.call("skirt", Transform3D(face_basis, centre + d * (half - 0.03) + Vector3(0.0, SKIRT_LOW, 0.0)))
			_box(body, _axis_size(d, WALL_DEPTH, out.cell_size, CROWN + 0.6),
				at + d * (WALL_DEPTH * 0.5) + Vector3(0.0, (CROWN + 0.6) * 0.5, 0.0))
			# A dead end's end wall carries the lunette up under its barrel.
			if cell.kind in ["dead", "gate"] and _is_end_wall(cell, side):
				add.call("wall_top", Transform3D(face_basis, at + Vector3(0.0, LUNETTE_BASE, 0.0)))
				if cell.kind == "gate":
					add.call("door", Transform3D(face_basis, at - d * DOOR_PROUD))

		# Pillars in the four corners of a junction.
		if cell.kind in JUNCTIONS:
			for px: float in [-1.0, 1.0]:
				for pz: float in [-1.0, 1.0]:
					var p := centre + Vector3(px, 0.0, pz) * PILLAR_AT
					var b := Basis(Vector3.UP, float(rng.randi_range(0, 3)) * PI * 0.5)
					add.call("pillar", Transform3D(b, p))
					_box(body, Vector3(PILLAR_HALF * 2.0, PILLAR_HEIGHT, PILLAR_HALF * 2.0),
						p + Vector3(0.0, PILLAR_HEIGHT * 0.5, 0.0))

	# Everyone stands on one flat slab, as before.
	var floor_body := StaticBody3D.new()
	floor_body.name = "BrickFloor"
	floor_body.collision_layer = LAYER_WORLD
	holder.add_child(floor_body)
	var span_x: float = float(out.size.x) * out.cell_size
	var span_z: float = float(out.size.y) * out.cell_size
	var mid_all: Vector3 = out.to_world(Vector2i(0, 0)) + Vector3(span_x * 0.5 - half, 0.0, span_z * 0.5 - half)
	_box(floor_body, Vector3(span_x, 1.2, span_z), mid_all + Vector3(0.0, -0.6, 0.0))

	_emit(holder, out, kit, placed, view_range)
	return holder


static func _in_boss_block(out, cell) -> bool:
	var boss: Dictionary = out.boss_room()
	if boss.is_empty():
		return false
	var c: Vector2i = boss["centre"]
	var h: int = boss["half"]
	return absi(cell.pos.x - c.x) <= h and absi(cell.pos.y - c.y) <= h


## A dead end's end wall is the one opposite its single opening.
static func _is_end_wall(cell, side: int) -> bool:
	var opposite := {ModuleMaze.N: ModuleMaze.S, ModuleMaze.S: ModuleMaze.N,
		ModuleMaze.E: ModuleMaze.W, ModuleMaze.W: ModuleMaze.E}
	return (cell.open & opposite[side]) != 0


static func _arch_collision(body: StaticBody3D, mid: Vector3, d: Vector3) -> void:
	var across := Vector3(d.z, 0.0, d.x).abs()
	var leg := ARCH_OUTER - ARCH_INNER + 0.2
	for s: float in [-1.0, 1.0]:
		var c := mid + across * s * (ARCH_INNER + leg * 0.5) + Vector3(0.0, ARCH_LEG_HEIGHT * 0.5, 0.0)
		_box(body, _axis_size(d, ARCH_DEPTH, leg, ARCH_LEG_HEIGHT), c)


static func _axis_size(dir: Vector3, depth: float, width: float, height: float) -> Vector3:
	if absf(dir.x) > 0.5:
		return Vector3(depth, height, width)
	return Vector3(width, height, depth)


static func _box(body: StaticBody3D, size: Vector3, centre: Vector3) -> void:
	var shape := BoxShape3D.new()
	shape.size = size
	var cs := CollisionShape3D.new()
	cs.shape = shape
	cs.position = centre
	body.add_child(cs)


static var _bed_mesh: Mesh = null
static var _cap_mesh: Mesh = null


static var _skirt_mesh: Mesh = null


## A thin dark panel across a closed side, its foot at the instance origin.
static func _skirt() -> Mesh:
	if _skirt_mesh != null:
		return _skirt_mesh
	var box := BoxMesh.new()
	box.size = Vector3(6.04, CAP_Y + 0.12 - SKIRT_LOW, 0.04)
	box.material = (_cap() as BoxMesh).material
	# Foot at the origin.
	var st := SurfaceTool.new()
	st.create_from(box, 0)
	var arr := st.commit_to_arrays()
	var verts: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
	for i in verts.size():
		verts[i].y += box.size.y * 0.5
	arr[Mesh.ARRAY_VERTEX] = verts
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	mesh.surface_set_material(0, box.material)
	_skirt_mesh = mesh
	return mesh


static func _cap() -> Mesh:
	if _cap_mesh != null:
		return _cap_mesh
	var box := BoxMesh.new()
	box.size = Vector3(6.02, 0.24, 6.02)
	var m := StandardMaterial3D.new()
	m.albedo_color = Color(0.03, 0.028, 0.03)
	m.roughness = 1.0
	m.specular_mode = BaseMaterial3D.SPECULAR_DISABLED
	box.material = m
	_cap_mesh = box
	return box


## The dark bed under the flagstones: what shows in the joints between them.
static func _bed() -> Mesh:
	if _bed_mesh != null:
		return _bed_mesh
	var box := BoxMesh.new()
	box.size = Vector3(6.0, 0.2, 6.0)
	var m := StandardMaterial3D.new()
	m.albedo_color = Color(0.085, 0.062, 0.044)
	m.roughness = 1.0
	m.specular_mode = BaseMaterial3D.SPECULAR_DISABLED
	box.material = m
	_bed_mesh = box
	return box


static func _emit(holder: Node3D, out, kit: Dictionary, placed: Dictionary, view_range: float) -> void:
	var jitter := RandomNumberGenerator.new()
	var counts := {}
	# `-- --brick-skip=bed,cap` leaves pieces out, for measuring what they cost.
	var skip: PackedStringArray = []
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--brick-skip="):
			skip = a.trim_prefix("--brick-skip=").split(",")
	for piece in placed:
		if piece in skip:
			continue
		var mesh: Mesh = kit.get(piece)
		if piece == "bed":
			mesh = _bed()
		elif piece == "cap":
			mesh = _cap()
		elif piece == "skirt":
			mesh = _skirt()
		if mesh == null:
			push_warning("brick_level: no mesh '%s' in the kit" % piece)
			continue
		var tinted: bool = not (piece in ["bed", "cap", "skirt"])
		for chunk in placed[piece]:
			var list: Array = placed[piece][chunk]
			# Node at the chunk's centre: a visibility range is measured from
			# the node's origin (CLAUDE.md, module level).
			var origin: Vector3 = out.to_world(Vector2i(chunk.x * 4, chunk.y * 4)) \
				+ Vector3(1.0, 0.0, 1.0) * (1.5 * out.cell_size)
			var mm := MultiMesh.new()
			mm.transform_format = MultiMesh.TRANSFORM_3D
			mm.use_colors = tinted
			mm.mesh = mesh
			mm.instance_count = list.size()
			for i in list.size():
				var xf: Transform3D = list[i]
				mm.set_instance_transform(i, Transform3D(xf.basis, xf.origin - origin))
				if tinted:
					jitter.seed = hash(Vector3i(xf.origin.round())) ^ hash(piece)
					var v := 1.0 + jitter.randf_range(-VALUE_JITTER, VALUE_JITTER)
					var w := jitter.randf_range(-WARMTH_JITTER, WARMTH_JITTER)
					mm.set_instance_color(i, Color(v + w, v, v - w * 0.6))
			var mmi := MultiMeshInstance3D.new()
			mmi.name = "%s_%d_%d" % [piece, chunk.x, chunk.y]
			mmi.multimesh = mm
			mmi.position = origin
			mmi.visibility_range_end = view_range + 4.0 * out.cell_size * 0.708
			mmi.visibility_range_end_margin = out.cell_size
			mmi.cast_shadow = (GeometryInstance3D.SHADOW_CASTING_SETTING_OFF if piece in NO_SHADOW
				else GeometryInstance3D.SHADOW_CASTING_SETTING_ON)
			if piece in MOON_ONLY:
				mmi.layers = MOON_ONLY_LAYER
			elif piece == "floor":
				mmi.layers = 1 | WET_LAYER
			holder.add_child(mmi)
			counts[piece] = int(counts.get(piece, 0)) + list.size()
	holder.set_meta("counts", counts)
	print("[brick] ", counts)
